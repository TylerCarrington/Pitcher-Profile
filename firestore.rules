rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coach accounts and their synchronized team/pitcher state
    match /coaches/{coachId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Shared teams and roster data
    match /teams/{teamId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Shared invite codes registry
    match /invite_codes/{code} {
      allow read, write: if true;
    }

    // Catch-all document access
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

